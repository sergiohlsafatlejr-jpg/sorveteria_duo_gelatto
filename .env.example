# ── App Configuration ──────────────────────────────────
NODE_ENV=development
PORT=3000
VITE_APP_ID=your-app-id
VITE_OAUTH_PORTAL_URL=https://oauth.example.com

# ── Database (MySQL / Drizzle ORM) ─────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/duo_gelatto

# ── Auth & Session ─────────────────────────────────────
JWT_SECRET=your-jwt-secret-key
OAUTH_SERVER_URL=https://oauth.example.com
OWNER_OPEN_ID=your-owner-openid

# ── Forge Storage Proxy API ────────────────────────────
BUILT_IN_FORGE_API_URL=https://storage.example.com
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# ── INOVE PDV Integration (MSSQL Server) ──────────────
INOVE_MSSQL_SERVER=127.0.0.1
INOVE_MSSQL_DATABASE=DUOGELATTO
INOVE_MSSQL_USER=sa
INOVE_MSSQL_PASSWORD=your-password

# ── WhatsApp Integration (Z-API) ───────────────────────
ZAPI_INSTANCE_ID=your-zapi-instance-id
ZAPI_TOKEN=your-zapi-token

# ── Meta & Instagram Graph API ─────────────────────────
META_ACCESS_TOKEN=your-meta-access-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-account-id
